<Window x:Class="wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d"
        Title="Calculator by dorothei"
        KeyDown="WindowKeyDown"
        SizeToContent="WidthAndHeight">

    <DockPanel>
        <TextBox x:Name="TextBox"
                 Text="{Binding CurrentInput, Mode=OneWay}"
                 DockPanel.Dock="Top"
                 Height="Auto"
                 Margin="12,12,12,8"
                 Padding="10,0"
                 FontWeight="SemiBold"
                 IsReadOnly="True"
                 Focusable="False"
                 FontSize="32"
                 TextAlignment="Right"
                 VerticalAlignment="Center"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--789 кнопки-->
            <Button x:Name="ButtonSeven"
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="7"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonEight"
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="8"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonNine"
                    Grid.Row="1"
                    Grid.Column="2"
                    Content="9"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <!--456 кнопки-->
            <Button x:Name="ButtonFour"
                    Grid.Row="2"
                    Grid.Column="0"
                    Content="4"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonFive"
                    Grid.Row="2"
                    Grid.Column="1"
                    Content="5"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonSix"
                    Grid.Row="2"
                    Grid.Column="2"
                    Content="6"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <!--123 кнопки-->
            <Button x:Name="ButtonOne"
                    Grid.Row="3"
                    Grid.Column="0"
                    Content="1"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonTwo"
                    Grid.Row="3"
                    Grid.Column="1"
                    Content="2"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>

            <Button x:Name="ButtonThree"
                    Grid.Row="3"
                    Grid.Column="2"
                    Content="3"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <!--Кнопки 0 +- ,  -->
            <Button x:Name="ButtonZero"
                    Grid.Row="4"
                    Grid.Column="1"
                    Content="0"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="PointButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    Content=","
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <!--Служебные кнопки-->
            <Button x:Name="ButtonClear"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="C"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="ClearButtonClick"/>
            <Button x:Name="DeleteButton"
                    Grid.Row="0"
                    Grid.Column="5"
                    Content="⌫"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="DeleteButtonClick"/>
            <Button x:Name="SolutionButton"
                    Grid.Row="4"
                    Grid.Column="4"
                    Content="="
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="SolutionButtonClick"/>
            <!--Мат. знаки-->
            <Button x:Name="PlusButton"
                    Grid.Row="3"
                    Grid.Column="4"
                    Content="+"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="MinusButton"
                    Grid.Row="2"
                    Grid.Column="4"
                    Content="-"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="PowButton"
                    Grid.Row="4"
                    Grid.Column="0"
                    Content="^"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="DivideButton"
                    Grid.Row="0"
                    Grid.Column="4"
                    Content="/"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="MultiplyButton"
                    Grid.Row="1"
                    Grid.Column="4"
                    Content="*"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="LeftBracketButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="("
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
            <Button x:Name="RightBracketButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Content=")"
                    Width="60"
                    Height="50"
                    FontSize="18"
                    Margin="5"
                    Click="NumberButtonClick"/>
        </Grid>
    </DockPanel>
</Window>